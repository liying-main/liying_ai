    "express": "^5.2.1",
    "iconv-lite": "^0.6.3",
    "opencc-js": "^1.0.5",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
